{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "appGroups": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "apps": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                },
                "protocol": {
                  "type": "string",
                  "enum": ["http", "tcp"]
                },
                "readiness": {
                  "default": "tcp",
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "tcp"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "path": {
                          "default": "/",
                          "type": "string",
                          "pattern": "^\\/.*"
                        },
                        "statuses": {
                          "default": "200-399",
                          "type": "string",
                          "pattern": "^\\d{3}-\\d{3}$"
                        },
                        "timeoutSeconds": {
                          "default": 60,
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 300
                        },
                        "type": {
                          "type": "string",
                          "const": "http"
                        }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": ["protocol"],
              "additionalProperties": false
            }
          },
          "category": {
            "type": "string",
            "enum": ["application", "infrastructure"]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^\\/.*"
                }
              },
              "required": ["file"],
              "additionalProperties": false
            }
          },
          "instances": {
            "default": {
              "mode": "per-worktree"
            },
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "per-worktree"
                  }
                },
                "required": ["mode"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "selectable"
                  }
                },
                "required": ["mode"],
                "additionalProperties": false
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "outputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "start": {
            "type": "object",
            "properties": {
              "argv": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["argv"],
            "additionalProperties": false
          },
          "stop": {
            "anyOf": [
              {
                "type": "string",
                "const": "process"
              },
              {
                "type": "object",
                "properties": {
                  "argv": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["argv"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["apps", "start", "stop"],
        "additionalProperties": false
      }
    },
    "managedResources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["file"],
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1
        },
        "definitions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "connections": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "instance": {
                          "type": "string",
                          "minLength": 1
                        },
                        "policy": {
                          "type": "string",
                          "const": "managed"
                        },
                        "resource": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["instance", "policy", "resource"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "idle": {
                          "type": "string",
                          "enum": ["keep-running", "stop-when-unused"]
                        },
                        "policy": {
                          "type": "string",
                          "const": "project"
                        }
                      },
                      "required": ["policy"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "idle": {
                          "type": "string",
                          "enum": ["keep-running", "stop-when-unused"]
                        },
                        "policy": {
                          "type": "string",
                          "const": "worktree"
                        }
                      },
                      "required": ["policy"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "policy": {
                          "type": "string",
                          "const": "existing"
                        },
                        "resource": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["policy", "resource"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["connections", "name"],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "profile": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["branch", "profile"],
            "additionalProperties": false
          }
        }
      },
      "required": ["default", "definitions"],
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "argv": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["argv"],
      "additionalProperties": false
    },
    "version": {
      "type": "number",
      "const": 1
    }
  },
  "required": ["appGroups", "setup", "version"],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/FranciscoMoretti/BranchBase/main/schema/branchbase.schema.json",
  "description": "Configure repository commands, dynamic App endpoints, readiness, and exposed App-group environments.",
  "title": "BranchBase configuration"
}
